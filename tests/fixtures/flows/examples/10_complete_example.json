{
  "uuid": "complete-example-flow",
  "name": "Complete Flow Example - User Verification",
  "nodes": [
    {
      "uuid": "start-001",
      "type": "entry",
      "name": "Start",
      "position": { "x": 0.0, "y": 0.0 },
      "data": {
        "type": "entry",
        "initial_variables": {
          "user_id": "12345",
          "api_key": "sk-xxx"
        }
      },
      "ports": null
    },
    {
      "uuid": "http-001",
      "type": "http",
      "name": "Get User Info",
      "position": { "x": 100.0, "y": 0.0 },
      "data": {
        "type": "http",
        "url": "https://api.example.com/users/{{initial_variables.user_id}}",
        "method": "get",
        "headers": {
          "Authorization": "Bearer {{initial_variables.api_key}}"
        }
      },
      "ports": null
    },
    {
      "uuid": "conditional-001",
      "type": "conditional",
      "name": "Check User Status",
      "position": { "x": 200.0, "y": 0.0 },
      "data": {
        "type": "conditional",
        "condition_type": "simple",
        "field_path": "http_response.data.status",
        "operator": "equal",
        "expected_value": "active"
      },
      "ports": null
    },
    {
      "uuid": "end-001",
      "type": "end",
      "name": "Normal End",
      "position": { "x": 300.0, "y": -50.0 },
      "data": {
        "type": "end"
      },
      "ports": null
    },
    {
      "uuid": "end-002",
      "type": "end",
      "name": "Abnormal End",
      "position": { "x": 300.0, "y": 50.0 },
      "data": {
        "type": "end"
      },
      "ports": null
    }
  ],
  "connections": [
    {
      "id": "conn-001",
      "source_node_uuid": "start-001",
      "target_node_uuid": "http-001",
      "source_port_id": "output",
      "target_port_id": "input"
    },
    {
      "id": "conn-002",
      "source_node_uuid": "http-001",
      "target_node_uuid": "conditional-001",
      "source_port_id": "output",
      "target_port_id": "input"
    },
    {
      "id": "conn-003",
      "source_node_uuid": "conditional-001",
      "target_node_uuid": "end-001",
      "source_port_id": "true",
      "target_port_id": "input"
    },
    {
      "id": "conn-004",
      "source_node_uuid": "conditional-001",
      "target_node_uuid": "end-002",
      "source_port_id": "false",
      "target_port_id": "input"
    }
  ]
}
