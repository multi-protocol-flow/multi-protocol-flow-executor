{
  "_version": 1,
  "flow": {
    "uuid": "grpc-unary-test",
    "name": "gRPC Unary 调用测试",
    "initial_variables": {},
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "入口",
        "position": { "x": 0, "y": 0 },
        "data": { "type": "entry" }
      },
      {
        "uuid": "grpc-conn",
        "type": "grpc_connect",
        "name": "gRPC 连接",
        "position": { "x": 250, "y": 0 },
        "data": {
          "type": "grpc_connect",
          "url": "http://127.0.0.1:50051",
          "use_tls": false,
          "tls_skip_verify": false,
          "enable_reflection": true,
          "proto_files": [],
          "default_metadata": [],
          "connect_timeout_ms": 5000
        }
      },
      {
        "uuid": "grpc-hello",
        "type": "grpc_call",
        "name": "SayHello",
        "position": { "x": 500, "y": 0 },
        "data": {
          "type": "grpc_call",
          "connection_id": "grpc-conn",
          "service_name": "testserver.TestService",
          "method_name": "SayHello",
          "request_json": "{\"name\": \"World\"}",
          "timeout_ms": 10000,
          "metadata": [],
          "request_messages": []
        }
      },
      {
        "uuid": "grpc-echo",
        "type": "grpc_call",
        "name": "Echo",
        "position": { "x": 750, "y": 0 },
        "data": {
          "type": "grpc_call",
          "connection_id": "grpc-conn",
          "service_name": "testserver.TestService",
          "method_name": "Echo",
          "request_json": "{\"message\": \"test echo message\"}",
          "timeout_ms": 10000,
          "metadata": [],
          "request_messages": []
        }
      },
      {
        "uuid": "grpc-calc",
        "type": "grpc_call",
        "name": "Calculate",
        "position": { "x": 1000, "y": 0 },
        "data": {
          "type": "grpc_call",
          "connection_id": "grpc-conn",
          "service_name": "testserver.TestService",
          "method_name": "Calculate",
          "request_json": "{\"a\": 42, \"b\": 13, \"operation\": \"add\"}",
          "timeout_ms": 10000,
          "metadata": [],
          "request_messages": []
        }
      },
      {
        "uuid": "grpc-close",
        "type": "grpc_close",
        "name": "关闭连接",
        "position": { "x": 1250, "y": 0 },
        "data": {
          "type": "grpc_close",
          "connection_id": "grpc-conn"
        }
      }
    ],
    "connections": [
      { "id": "c1", "source_node_uuid": "entry-001", "target_node_uuid": "grpc-conn", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c2", "source_node_uuid": "grpc-conn", "target_node_uuid": "grpc-hello", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c3", "source_node_uuid": "grpc-hello", "target_node_uuid": "grpc-echo", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c4", "source_node_uuid": "grpc-echo", "target_node_uuid": "grpc-calc", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c5", "source_node_uuid": "grpc-calc", "target_node_uuid": "grpc-close", "source_port_id": "out", "target_port_id": "in" }
    ]
  },
  "_meta": null
}
