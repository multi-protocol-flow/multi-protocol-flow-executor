{
  "_version": 1,
  "flow": {
    "uuid": "tcp-line-delimiter",
    "name": "TCP Line Protocol - Delimiter Framing",
    "initial_variables": {},
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "入口",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "type": "entry"
        }
      },
      {
        "uuid": "tcp-conn-001",
        "type": "tcp_connect",
        "name": "TCP 连接 - Line 服务器",
        "position": {
          "x": 250,
          "y": 0
        },
        "data": {
          "type": "tcp_connect",
          "host": "127.0.0.1",
          "port": 9002,
          "use_tls": false,
          "tls_skip_verify": false,
          "connect_timeout_ms": 5000,
          "framing_mode": {
            "delimiter": {
              "delimiter": "\\n"
            }
          },
          "framing_config": {
            "mode": {
              "delimiter": {
                "delimiter": "\\n"
              }
            },
            "max_frame_size": 1048576,
            "include_framing_in_data": false
          }
        }
      },
      {
        "uuid": "tcp-send-001",
        "type": "tcp_send",
        "name": "发送 PING 命令",
        "position": {
          "x": 500,
          "y": 0
        },
        "data": {
          "type": "tcp_send",
          "connection_id": "tcp-conn-001",
          "data": "PING\\n",
          "data_encoding": "text",
          "framing_mode": {
            "delimiter": {
              "delimiter": "\\n"
            }
          },
          "framing_config": {
            "mode": {
              "delimiter": {
                "delimiter": "\\n"
              }
            },
            "max_frame_size": 1048576,
            "include_framing_in_data": false
          },
          "send_timeout_ms": 5000
        }
      },
      {
        "uuid": "tcp-close-001",
        "type": "tcp_close",
        "name": "关闭连接",
        "position": {
          "x": 750,
          "y": 0
        },
        "data": {
          "type": "tcp_close",
          "connection_id": "tcp-conn-001",
          "close_timeout_ms": 5000
        }
      }
    ],
    "connections": [
      {
        "id": "conn-1",
        "source_node_uuid": "entry-001",
        "target_node_uuid": "tcp-conn-001",
        "source_port_id": "out",
        "target_port_id": "in"
      },
      {
        "id": "conn-2",
        "source_node_uuid": "tcp-conn-001",
        "target_node_uuid": "tcp-send-001",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "conn-3",
        "source_node_uuid": "tcp-send-001",
        "target_node_uuid": "tcp-close-001",
        "source_port_id": "true",
        "target_port_id": "in"
      }
    ]
  },
  "_meta": null
}