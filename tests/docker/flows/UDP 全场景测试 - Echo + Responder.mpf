{
  "_version": 1,
  "flow": {
    "uuid": "udp-all-scenarios",
    "name": "UDP 全场景测试 - Echo + Responder",
    "initial_variables": {},
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "入口",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "type": "entry"
        }
      },
      {
        "uuid": "udp-bind-001",
        "type": "udp_bind",
        "name": "UDP 绑定",
        "position": {
          "x": 250,
          "y": 0
        },
        "data": {
          "type": "udp_bind",
          "local_addr": "0.0.0.0",
          "local_port": 0,
          "reuse_addr": true
        }
      },
      {
        "uuid": "udp-send-001",
        "type": "udp_send_to",
        "name": "发送 UDP Echo",
        "position": {
          "x": 500,
          "y": 0
        },
        "data": {
          "type": "udp_send_to",
          "connection_id": "udp-bind-001",
          "data": "Hello UDP!",
          "data_encoding": "text",
          "target_addr": "127.0.0.1",
          "target_port": 9101,
          "send_timeout_ms": 5000
        }
      },
      {
        "uuid": "udp-recv-001",
        "type": "udp_recv_from",
        "name": "接收 Echo 响应",
        "position": {
          "x": 750,
          "y": 0
        },
        "data": {
          "type": "udp_recv_from",
          "connection_id": "udp-bind-001",
          "receive_timeout_ms": 5000,
          "max_size": 65536
        }
      },
      {
        "uuid": "udp-send-002",
        "type": "udp_send_to",
        "name": "发送 ping",
        "position": {
          "x": 1000,
          "y": 0
        },
        "data": {
          "type": "udp_send_to",
          "connection_id": "udp-bind-001",
          "data": "ping",
          "data_encoding": "text",
          "target_addr": "127.0.0.1",
          "target_port": 9102,
          "send_timeout_ms": 5000
        }
      },
      {
        "uuid": "udp-recv-002",
        "type": "udp_recv_from",
        "name": "接收 pong 响应",
        "position": {
          "x": 1250,
          "y": 0
        },
        "data": {
          "type": "udp_recv_from",
          "connection_id": "udp-bind-001",
          "receive_timeout_ms": 5000,
          "max_size": 65536
        }
      },
      {
        "uuid": "udp-send-003",
        "type": "udp_send_to",
        "name": "发送 hello",
        "position": {
          "x": 1500,
          "y": 0
        },
        "data": {
          "type": "udp_send_to",
          "connection_id": "udp-bind-001",
          "data": "hello",
          "data_encoding": "text",
          "target_addr": "127.0.0.1",
          "target_port": 9102,
          "send_timeout_ms": 5000
        }
      },
      {
        "uuid": "udp-recv-003",
        "type": "udp_recv_from",
        "name": "接收 world 响应",
        "position": {
          "x": 1750,
          "y": 0
        },
        "data": {
          "type": "udp_recv_from",
          "connection_id": "udp-bind-001",
          "receive_timeout_ms": 5000,
          "max_size": 65536
        }
      },
      {
        "uuid": "udp-close-001",
        "type": "udp_close",
        "name": "关闭 UDP",
        "position": {
          "x": 2000,
          "y": 0
        },
        "data": {
          "type": "udp_close",
          "connection_id": "udp-bind-001"
        }
      }
    ],
    "connections": [
      {
        "id": "c1",
        "source_node_uuid": "entry-001",
        "target_node_uuid": "udp-bind-001",
        "source_port_id": "out",
        "target_port_id": "in"
      },
      {
        "id": "c2",
        "source_node_uuid": "udp-bind-001",
        "target_node_uuid": "udp-send-001",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c3",
        "source_node_uuid": "udp-send-001",
        "target_node_uuid": "udp-recv-001",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c4",
        "source_node_uuid": "udp-recv-001",
        "target_node_uuid": "udp-send-002",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c5",
        "source_node_uuid": "udp-send-002",
        "target_node_uuid": "udp-recv-002",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c6",
        "source_node_uuid": "udp-recv-002",
        "target_node_uuid": "udp-send-003",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c7",
        "source_node_uuid": "udp-send-003",
        "target_node_uuid": "udp-recv-003",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c8",
        "source_node_uuid": "udp-recv-003",
        "target_node_uuid": "udp-close-001",
        "source_port_id": "true",
        "target_port_id": "in"
      }
    ]
  },
  "_meta": null
}