{
  "_version": 1,
  "flow": {
    "uuid": "mcp-streamable-http-test",
    "name": "MCP Streamable HTTP 测试",
    "initial_variables": {},
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "入口",
        "position": { "x": 0, "y": 0 },
        "data": { "type": "entry" }
      },
      {
        "uuid": "mcp-conn",
        "type": "mcp_connect",
        "name": "MCP 连接 (Streamable HTTP)",
        "position": { "x": 250, "y": 0 },
        "data": {
          "type": "mcp_connect",
          "url": "http://127.0.0.1:9085/mcp",
          "transport": "streamable_http",
          "headers": {},
          "protocol_version": "2024-11-05",
          "custom_headers": null,
          "command": null,
          "args": null,
          "env": null,
          "discovered_tools": [],
          "discovered_resources": [],
          "discovered_prompts": []
        }
      },
      {
        "uuid": "mcp-tool-echo",
        "type": "mcp_call_tool",
        "name": "调用 Echo 工具",
        "position": { "x": 500, "y": 0 },
        "data": {
          "type": "mcp_call_tool",
          "connection_id": "mcp-conn",
          "tool_name": "echo",
          "arguments": { "text": "Hello MCP!" }
        }
      },
      {
        "uuid": "mcp-tool-add",
        "type": "mcp_call_tool",
        "name": "调用 Add 工具",
        "position": { "x": 750, "y": 0 },
        "data": {
          "type": "mcp_call_tool",
          "connection_id": "mcp-conn",
          "tool_name": "add",
          "arguments": { "a": 42, "b": 58 }
        }
      },
      {
        "uuid": "mcp-resource",
        "type": "mcp_read_resource",
        "name": "读取 Server Info",
        "position": { "x": 1000, "y": 0 },
        "data": {
          "type": "mcp_read_resource",
          "connection_id": "mcp-conn",
          "resource_uri": "test://info"
        }
      },
      {
        "uuid": "mcp-prompt",
        "type": "mcp_get_prompt",
        "name": "获取 Greeting Prompt",
        "position": { "x": 1250, "y": 0 },
        "data": {
          "type": "mcp_get_prompt",
          "connection_id": "mcp-conn",
          "prompt_name": "greeting",
          "arguments": { "name": "MCP Tester" }
        }
      },
      {
        "uuid": "mcp-close",
        "type": "mcp_close",
        "name": "关闭连接",
        "position": { "x": 1500, "y": 0 },
        "data": {
          "type": "mcp_close",
          "connection_id": "mcp-conn"
        }
      }
    ],
    "connections": [
      { "id": "c1", "source_node_uuid": "entry-001", "target_node_uuid": "mcp-conn", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c2", "source_node_uuid": "mcp-conn", "target_node_uuid": "mcp-tool-echo", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c3", "source_node_uuid": "mcp-tool-echo", "target_node_uuid": "mcp-tool-add", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c4", "source_node_uuid": "mcp-tool-add", "target_node_uuid": "mcp-resource", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c5", "source_node_uuid": "mcp-resource", "target_node_uuid": "mcp-prompt", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c6", "source_node_uuid": "mcp-prompt", "target_node_uuid": "mcp-close", "source_port_id": "out", "target_port_id": "in" }
    ]
  },
  "_meta": null
}
