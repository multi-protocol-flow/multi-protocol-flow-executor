{
  "_version": 1,
  "flow": {
    "uuid": "mqtt-pub-sub-test",
    "name": "MQTT 发布订阅测试",
    "initial_variables": {},
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "入口",
        "position": { "x": 0, "y": 0 },
        "data": { "type": "entry" }
      },
      {
        "uuid": "mqtt-conn",
        "type": "mqtt_connect",
        "name": "MQTT 连接",
        "position": { "x": 250, "y": 0 },
        "data": {
          "type": "mqtt_connect",
          "url": "mqtt://127.0.0.1:11883",
          "client_id": "mpe-test-client",
          "username": null,
          "password": null,
          "mqtt_version": "5.0",
          "clean_session": true,
          "keep_alive_secs": 60,
          "connect_timeout_ms": 5000
        }
      },
      {
        "uuid": "mqtt-sub",
        "type": "mqtt_subscribe",
        "name": "订阅 test/response",
        "position": { "x": 500, "y": -100 },
        "data": {
          "type": "mqtt_subscribe",
          "connection_id": "mqtt-conn",
          "topic": "test/response",
          "qos": 0,
          "max_messages": 1,
          "collect_timeout_ms": 10000,
          "output_mode": "first"
        }
      },
      {
        "uuid": "mqtt-pub",
        "type": "mqtt_publish",
        "name": "发布�?test/topic",
        "position": { "x": 500, "y": 100 },
        "data": {
          "type": "mqtt_publish",
          "connection_id": "mqtt-conn",
          "topic": "test/topic",
          "payload": "{\"message\": \"Hello MQTT!\", \"ts\": 1234567890}",
          "qos": 0,
          "retain": false,
          "payload_format": "json"
        }
      },
      {
        "uuid": "mqtt-disc",
        "type": "mqtt_disconnect",
        "name": "断开连接",
        "position": { "x": 750, "y": 0 },
        "data": {
          "type": "mqtt_disconnect",
          "connection_id": "mqtt-conn"
        }
      }
    ],
    "connections": [
      { "id": "c1", "source_node_uuid": "entry-001", "target_node_uuid": "mqtt-conn", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c2", "source_node_uuid": "mqtt-conn", "target_node_uuid": "mqtt-sub", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c3", "source_node_uuid": "mqtt-conn", "target_node_uuid": "mqtt-pub", "source_port_id": "out", "target_port_id": "in" },
      { "id": "c4", "source_node_uuid": "mqtt-sub", "target_node_uuid": "mqtt-disc", "source_port_id": "out", "target_port_id": "in" }
    ]
  },
  "_meta": null
}
