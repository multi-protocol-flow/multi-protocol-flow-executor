{
  "_version": 1,
  "flow": {
    "uuid": "full-workflow",
    "name": "Full Workflow Example",
    "initial_variables": {
      "api_base": "https://httpbin.org",
      "token": "test-token-xyz"
    },
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "Entry",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "type": "entry"
        },
        "ports": null
      },
      {
        "uuid": "http-001",
        "type": "http:request",
        "name": "Fetch User Data",
        "position": {
          "x": 100,
          "y": 0
        },
        "data": {
          "type": "http:request",
          "url": "{{initial_variables.api_base}}/get",
          "method": "get",
          "headers": {
            "Authorization": "Bearer {{initial_variables.token}}"
          }
        },
        "ports": null
      },
      {
        "uuid": "conditional-001",
        "type": "conditional",
        "name": "Validate Response Status",
        "position": {
          "x": 200,
          "y": 0
        },
        "data": {
          "type": "conditional",
          "condition_type": "advanced",
          "advanced_expression": "http_response.status >= 200 && http_response.status < 300"
        },
        "ports": null
      },
      {
        "uuid": "http-002",
        "type": "http:request",
        "name": "Success Handler",
        "position": {
          "x": 300,
          "y": -50
        },
        "data": {
          "type": "http:request",
          "url": "{{initial_variables.api_base}}/post",
          "method": "post",
          "body": {
            "status": "success",
            "original_data": "{{http_response.data}}"
          }
        },
        "ports": null
      },
      {
        "uuid": "http-003",
        "type": "http:request",
        "name": "Error Handler",
        "position": {
          "x": 300,
          "y": 50
        },
        "data": {
          "type": "http:request",
          "url": "{{initial_variables.api_base}}/post",
          "method": "post",
          "body": {
            "status": "error",
            "error_code": "{{http_response.status}}"
          }
        },
        "ports": null
      }
    ],
    "connections": [
      {
        "id": "conn-001",
        "source_node_uuid": "entry-001",
        "target_node_uuid": "http-001",
        "source_port_id": "output",
        "target_port_id": "input"
      },
      {
        "id": "conn-002",
        "source_node_uuid": "http-001",
        "target_node_uuid": "conditional-001",
        "source_port_id": "output",
        "target_port_id": "input"
      },
      {
        "id": "conn-003",
        "source_node_uuid": "conditional-001",
        "target_node_uuid": "http-002",
        "source_port_id": "true",
        "target_port_id": "input"
      },
      {
        "id": "conn-004",
        "source_node_uuid": "conditional-001",
        "target_node_uuid": "http-003",
        "source_port_id": "false",
        "target_port_id": "input"
      }
    ]
  },
  "_meta": null
}