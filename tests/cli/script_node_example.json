      "uuid": "script-1",
      "type": "script",
      "name": "脚本处理",
      "position": { "x": 400.0, "y": 0.0 },
      "data": {
        "type": "script",
        "script": "// 获取响应状态码\nvar status = fn.response.code;\n\n// 获取响应体（JSON 字符串，需要解析）\nvar bodyStr = fn.response.body;\nvar data = JSON.parse(bodyStr);\n\n// 提取 slideshow.title 并存储到变量\nvar title = data.slideshow.title;\nfn.variables.set('extracted_title', title);\n\n// 存储状态码\nfn.variables.set('response_status', status.toString());\n\n// 返回成功\ntrue;",
        "timeout_ms": 5000,
        "memory_limit_mb": 10,
        "execution_phase": "post_request",
        "on_error": "recoverable",
        "on_assertion_fail": "route_false"
      },
      "ports": null
    },
    {
      "uuid": "cond-1",
      "type": "conditional",
      "name": "验证提取的变量",
      "position": { "x": 600.0, "y": 0.0 },
      "data": {
        "type": "conditional",
        "condition_type": "simple",
        "field_path": "extracted_title",
        "operator": "exists",
        "expected_value": null
      },
      "ports": null
    },
