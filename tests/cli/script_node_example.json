        "uuid": "script-1",
        "type": "script",
        "name": "Script Processing",
        "position": {
          "x": 400,
          "y": 0
        },
        "data": {
          "type": "script",
          "script": "// Get response status code\nvar status = fn.response.code;\n\n// Get response body (JSON string, needs parsing)\nvar bodyStr = fn.response.body;\nvar data = JSON.parse(bodyStr);\n\n// Extract slideshow.title and store to variable\nvar title = data.slideshow.title;\nfn.variables.set('extracted_title', title);\n\n// Store status code\nfn.variables.set('response_status', status.toString());\n\n// Return success\ntrue;",
          "timeout_ms": 5000,
          "memory_limit_mb": 10,
          "execution_phase": "post_request",
          "on_error": "recoverable",
          "on_assertion_fail": "route_false"
        },
        "ports": null
      },
      {
        "uuid": "cond-1",
        "type": "conditional",
        "name": "Verify Extracted Variable",
        "position": {
          "x": 600,
          "y": 0
        },
        "data": {
          "type": "conditional",
          "condition_type": "simple",
          "field_path": "extracted_title",
          "operator": "exists",
          "expected_value": null
        },
