      "data": {
        "type": "db_query",
        "connection_uuid": "sqlite-conn-001",
        "sql": "CREATE TABLE IF NOT EXISTS test_table (id INTEGER PRIMARY KEY, name TEXT, value INTEGER)",
        "fetch_mode": "scalar",
        "timeout_ms": 5000
      },
      "ports": null
    },
    {
      "uuid": "db-query-002",
      "type": "db_query",
      "name": "插入测试数据",
