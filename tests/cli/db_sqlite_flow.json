        "result_to": "query_result",
        "timeout_ms": 5000
      },
      "ports": null
    },
    {
      "uuid": "db-close-001",
      "type": "db_close",
      "name": "关闭连接",
      "position": { "x": 500.0, "y": 0.0 },
