{
  "_version": 1,
  "flow": {
    "uuid": "multi-http-chain",
    "name": "Multi-HTTP Chain",
    "initial_variables": {
      "api_base": "https://httpbin.org"
    },
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "Entry",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "type": "entry"
        },
        "ports": null
      },
      {
        "uuid": "http-001",
        "type": "http:request",
        "name": "Step 1: Get UUID",
        "position": {
          "x": 100,
          "y": 0
        },
        "data": {
          "type": "http:request",
          "url": "{{api_base}}/uuid",
          "method": "get"
        },
        "ports": null
      },
      {
        "uuid": "extract-uuid",
        "type": "variable:extractor",
        "name": "Extract UUID",
        "position": {
          "x": 400,
          "y": 0
        },
        "data": {
          "type": "variable:extractor",
          "output_mappings": [
            {
              "source": "$.body.uuid",
              "target": "uuid_from_step1",
              "description": "UUID returned by /uuid"
            }
          ],
          "source_node_id": "http-001"
        },
        "ports": null,
        "has_breakpoint": null
      },
      {
        "uuid": "http-002",
        "type": "http:request",
        "name": "Step 2: Request with UUID",
        "position": {
          "x": 200,
          "y": 0
        },
        "data": {
          "type": "http:request",
          "url": "{{api_base}}/post",
          "method": "post",
          "body": "{\"uuid_from_step1\": \"{{uuid_from_step1}}\"}",
          "body_type": "body",
          "content_type": "json"
        },
        "ports": null
      },
      {
        "uuid": "http-003",
        "type": "http:request",
        "name": "Step 3: Final Confirmation",
        "position": {
          "x": 300,
          "y": 0
        },
        "data": {
          "type": "http:request",
          "url": "{{api_base}}/get",
          "method": "get"
        },
        "ports": null
      }
    ],
    "connections": [
      {
        "id": "c1",
        "source_node_uuid": "entry-001",
        "target_node_uuid": "http-001",
        "source_port_id": "out",
        "target_port_id": "in"
      },
      {
        "id": "c2",
        "source_node_uuid": "http-001",
        "target_node_uuid": "extract-uuid",
        "source_port_id": "true",
        "target_port_id": "in"
      },
      {
        "id": "c3",
        "source_node_uuid": "extract-uuid",
        "target_node_uuid": "http-002",
        "source_port_id": "out",
        "target_port_id": "in"
      },
      {
        "id": "c4",
        "source_node_uuid": "http-002",
        "target_node_uuid": "http-003",
        "source_port_id": "true",
        "target_port_id": "in"
      }
    ]
  },
  "_meta": null
}
