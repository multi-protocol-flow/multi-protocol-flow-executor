{
  "uuid": "multi-http-chain",
  "name": "多HTTP链式调用",
  "initial_variables": {
    "api_base": "https://httpbin.org"
  },
  "nodes": [
    {
      "uuid": "entry-001",
      "type": "entry",
      "name": "入口",
      "position": { "x": 0.0, "y": 0.0 },
      "data": { "type": "entry" },
      "ports": null
    },
    {
      "uuid": "http-001",
      "type": "http",
      "name": "第一步：获取UUID",
      "position": { "x": 100.0, "y": 0.0 },
      "data": {
        "type": "http",
        "url": "{{initial_variables.api_base}}/uuid",
        "method": "get"
      },
      "ports": null
    },
    {
      "uuid": "http-002",
      "type": "http",
      "name": "第二步：使用UUID请求",
      "position": { "x": 200.0, "y": 0.0 },
      "data": {
        "type": "http",
        "url": "{{initial_variables.api_base}}/post",
        "method": "post",
        "body": {
          "uuid_from_step1": "{{http_response.data.uuid}}"
        }
      },
      "ports": null
    },
    {
      "uuid": "http-003",
      "type": "http",
      "name": "第三步：最终确认",
      "position": { "x": 300.0, "y": 0.0 },
      "data": {
        "type": "http",
        "url": "{{initial_variables.api_base}}/get",
        "method": "get"
      },
      "ports": null
    }
  ],
  "connections": [
    { "id": "conn-001", "source_node_uuid": "entry-001", "target_node_uuid": "http-001", "source_port_id": "output", "target_port_id": "input" },
    { "id": "conn-002", "source_node_uuid": "http-001", "target_node_uuid": "http-002", "source_port_id": "output", "target_port_id": "input" },
    { "id": "conn-003", "source_node_uuid": "http-002", "target_node_uuid": "http-003", "source_port_id": "output", "target_port_id": "input" }
  ]
}
