{
  "_version": 1,
  "flow": {
    "uuid": "multi-http-chain",
    "name": "Multi-HTTP Chain",
    "initial_variables": {
      "api_base": "https://httpbin.org"
    },
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "Entry",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "type": "entry"
        },
        "ports": null
      },
      {
        "uuid": "http-001",
        "type": "http",
        "name": "Step 1: Get UUID",
        "position": {
          "x": 100,
          "y": 0
        },
        "data": {
          "type": "http",
          "url": "{{initial_variables.api_base}}/uuid",
          "method": "get"
        },
        "ports": null
      },
      {
        "uuid": "http-002",
        "type": "http",
        "name": "Step 2: Request with UUID",
        "position": {
          "x": 200,
          "y": 0
        },
        "data": {
          "type": "http",
          "url": "{{initial_variables.api_base}}/post",
          "method": "post",
          "body": {
            "uuid_from_step1": "{{http_response.data.uuid}}"
          }
        },
        "ports": null
      },
      {
        "uuid": "http-003",
        "type": "http",
        "name": "Step 3: Final Confirmation",
        "position": {
          "x": 300,
          "y": 0
        },
        "data": {
          "type": "http",
          "url": "{{initial_variables.api_base}}/get",
          "method": "get"
        },
        "ports": null
      }
    ],
    "connections": [
      {
        "id": "conn-001",
        "source_node_uuid": "entry-001",
        "target_node_uuid": "http-001",
        "source_port_id": "output",
        "target_port_id": "input"
      },
      {
        "id": "conn-002",
        "source_node_uuid": "http-001",
        "target_node_uuid": "http-002",
        "source_port_id": "output",
        "target_port_id": "input"
      },
      {
        "id": "conn-003",
        "source_node_uuid": "http-002",
        "target_node_uuid": "http-003",
        "source_port_id": "output",
        "target_port_id": "input"
      }
    ]
  },
  "_meta": null
}