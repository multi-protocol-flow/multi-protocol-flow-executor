{
  "_version": 1,
  "flow": {
    "uuid": "variable-reference",
    "name": "Variable Reference Example",
    "initial_variables": {
      "user_id": "12345",
      "api_key": "test-api-key-abc",
      "base_url": "https://httpbin.org"
    },
    "nodes": [
      {
        "uuid": "entry-001",
        "type": "entry",
        "name": "Entry",
        "position": {
          "x": 0,
          "y": 0
        },
        "data": {
          "type": "entry"
        },
        "ports": null
      },
      {
        "uuid": "http-001",
        "type": "http:request",
        "name": "Request with Variables",
        "position": {
          "x": 100,
          "y": 0
        },
        "data": {
          "type": "http:request",
          "url": "{{base_url}}/get?user_id={{user_id}}",
          "method": "get",
          "headers": {
            "Authorization": "Bearer {{api_key}}"
          }
        },
        "ports": null
      },
      {
        "uuid": "conditional-001",
        "type": "conditional",
        "name": "Check Response",
        "position": {
          "x": 200,
          "y": 0
        },
        "data": {
          "type": "conditional",
          "condition_type": "simple",
          "field_path": "$.status",
          "operator": "equal",
          "expected_value": 200
        },
        "ports": null
      }
    ],
    "connections": [
      {
        "id": "conn-001",
        "source_node_uuid": "entry-001",
        "target_node_uuid": "http-001",
        "source_port_id": "out",
        "target_port_id": "in"
      },
      {
        "id": "conn-002",
        "source_node_uuid": "http-001",
        "target_node_uuid": "conditional-001",
        "source_port_id": "true",
        "target_port_id": "in"
      }
    ]
  },
  "_meta": null
}
