{
  "uuid": "variable-reference",
  "name": "变量引用示例",
  "initial_variables": {
    "user_id": "12345",
    "api_key": "test-api-key-abc",
    "base_url": "https://httpbin.org"
  },
  "nodes": [
    {
      "uuid": "entry-001",
      "type": "entry",
      "name": "入口",
      "position": { "x": 0.0, "y": 0.0 },
      "data": { "type": "entry" },
      "ports": null
    },
    {
      "uuid": "http-001",
      "type": "http",
      "name": "使用变量请求",
      "position": { "x": 100.0, "y": 0.0 },
      "data": {
        "type": "http",
        "url": "{{initial_variables.base_url}}/get?user_id={{initial_variables.user_id}}",
        "method": "get",
        "headers": {
          "Authorization": "Bearer {{initial_variables.api_key}}"
        }
      },
      "ports": null
    },
    {
      "uuid": "conditional-001",
      "type": "conditional",
      "name": "检查响应",
      "position": { "x": 200.0, "y": 0.0 },
      "data": {
        "type": "conditional",
        "condition_type": "simple",
        "field_path": "http_response.status",
        "operator": "equal",
        "expected_value": 200
      },
      "ports": null
    }
  ],
  "connections": [
    { "id": "conn-001", "source_node_uuid": "entry-001", "target_node_uuid": "http-001", "source_port_id": "output", "target_port_id": "input" },
    { "id": "conn-002", "source_node_uuid": "http-001", "target_node_uuid": "conditional-001", "source_port_id": "output", "target_port_id": "input" }
  ]
}
