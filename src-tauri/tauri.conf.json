{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "multi-protocol-flow-executor",
  "version": "0.1.0",
  "identifier": "com.multi-protocol-flow-executor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multi-Protocol Flow Executor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#242424"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMENEQ0FGMzBCRDgwQkYKUldTL2dMMHdyOXdNQVBuWXE1RTNLL2xPZjBTcFh2MTNsRVVzT2tYdE90ZFNNL0daaHdhakpBeFAK",
      "endpoints": [
        "https://mpe-downloads.sunanzhi.com/manifest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
