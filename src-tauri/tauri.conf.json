{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "multi-protocol-flow-executor",
  "version": "0.3.0-beta.1",
  "identifier": "com.multi-protocol-flow-executor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multi-Protocol Flow Executor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#242424"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' tauri: http: https: ws: wss: data: blob:",
        "img-src": "'self' data:",
        "frame-src": "mpe-plugin: http://mpe-plugin.localhost http://*.mpe-plugin.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
